# Copy to .env for local testing. On Render / Railway set these in the dashboard (never commit real values).
NODE_ENV=development
APP_TZ=Asia/Kolkata
# Where the database, backups and ID files live. Render: the disk mount path (/var/data). Railway: /data
DB_DIR=./data
JWT_SECRET=            # 32+ random characters: openssl rand -hex 32
JWT_EXPIRES_IN=8h
AES_256_KEY=           # exactly 64 hex characters: openssl rand -hex 32  (NEVER change once live; same value when moving servers)
BCRYPT_ROUNDS=12
CRON_SECRET=
WEBHOOK_SECRET=
DISABLE_SCHEDULER=false

# First super-admin (created on first start). Locked out? Set SUPERADMIN_RESET=true, redeploy,
# sign in, then REMOVE SUPERADMIN_RESET.
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
SUPERADMIN_MOBILE=
SUPERADMIN_RESET=

# Subscriptions: days an owner can still use the app after the paid period ends
SUBSCRIPTION_GRACE_DAYS=7

# OTP / SMS codes (forgot password by OTP, staff "get code by SMS"). Off unless true.
OTP_ENABLED=false
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=

# Cloudflare R2 — off-site copies of every backup and ID-proof file (optional but recommended)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PREFIX=dormbook
# R2_ENDPOINT=         # only if not https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
# R2_KEEP_DAILY=30
# R2_KEEP_BOOT=10
# R2_KEEP_MANUAL=20
# Supabase Storage — a second off-site copy of every backup and ID file (S3 protocol).
# Supabase dashboard → Storage → create a PRIVATE bucket "dormbook-backups";
# Storage → S3 Connection → "New access key" (copy both keys) and note the Region shown there.
SUPABASE_URL=https://uqwzpodpnegzejhqdtta.supabase.co
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
SUPABASE_S3_REGION=
SUPABASE_BUCKET=dormbook-backups
SUPABASE_PREFIX=dormbook
# SUPABASE_S3_ENDPOINT=   # only if not https://<ref>.storage.supabase.co/storage/v1/s3
# New server / lost disk: start with an EMPTY disk and RESTORE_FROM_R2=latest (or a backup file name).
# The newest copy is taken from R2, or from Supabase when R2 has none.
# Remove it again after the first successful start.
RESTORE_FROM_R2=

# Moving servers: on the OLD server set REDIRECT_TO_URL=https://new-address to send everyone there.
REDIRECT_TO_URL=

# Optional
PUBLIC_URL=
CORS_ORIGINS=
# Visitor IP header for rate limits (Render default: cf-connecting-ip)
CLIENT_IP_HEADER=

# Rate limits (optional — defaults shown in src/middleware/rateLimits.js)
RL_AUTH_IP_MAX=40
RL_AUTH_IP_WINDOW_MIN=15
RL_CODE_PER_MOBILE_MAX=5
RL_CODE_WINDOW_MIN=60
RL_PUBLIC_MAX=120
RL_PUBLIC_WINDOW_SEC=60
RL_BILL_LINK_MAX=30
RL_USER_MAX=600
RL_USER_WINDOW_SEC=60
RL_IP_FLOOD_MAX=3000
RL_ADMIN_WRITE_MAX=120
RL_ADMIN_EXPORT_MAX=30
RL_LIVE_MAX=60
AUTH_FREE_TRIES=5
AUTH_BACKOFF_BASE_SEC=30
AUTH_BACKOFF_MAX_MIN=15
MPIN_WIPE_AT=10

# Live updates
SSE_MAX_CLIENTS=2000
SSE_MAX_PER_USER=6
